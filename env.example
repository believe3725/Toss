# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 값으로 채워주세요.
# .env 파일은 절대 깃허브 등 공개 저장소에 올리지 마세요.

# 토스증권 WTS(PC 웹) > 설정 > Open API 에서 발급받은 값
TOSS_CLIENT_ID=여기에_client_id
TOSS_CLIENT_SECRET=여기에_client_secret

# 가계부 앱이 이 서버를 호출할 때 사용할 임의의 비밀 문자열 (직접 정하면 됨, 아무 문자열이나 충분히 길게)
APP_TOKEN=여기에_직접_정한_긴_임의_문자열

# 서버 포트 (배포 환경에 맞게 조정)
PORT=3000

# 아래 세 값은 developers.tossinvest.com 공식 문서에서 정확한 경로를 확인한 뒤
# 다르면 여기서 덮어써주세요. (server.js의 기본값은 검색으로 확인한 추정치입니다)
# TOSS_TOKEN_URL=https://oauth2.tossinvest.com/oauth2/token
# TOSS_HOLDINGS_URL=https://openapi.tossinvest.com/api/v1/accounts/holdings
# TOSS_QUOTE_URL=https://openapi.tossinvest.com/api/v1/stocks
